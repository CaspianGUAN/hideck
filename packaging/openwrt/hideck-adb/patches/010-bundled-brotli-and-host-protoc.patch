From: HiDeck maintainers
Subject: Bundle Brotli statically and use the cross build's host protoc

OpenWrt 24.10 has no Brotli package. Keep the bundled library private and
use CMake's FindProtobuf with the explicitly supplied host protoc executable.

--- a/vendor/CMakeLists.txt
+++ b/vendor/CMakeLists.txt
@@ -88,6 +88,12 @@
 find_package(PkgConfig REQUIRED)
-pkg_check_modules(libbrotlicommon REQUIRED IMPORTED_TARGET libbrotlicommon)
-pkg_check_modules(libbrotlidec REQUIRED IMPORTED_TARGET libbrotlidec)
-pkg_check_modules(libbrotlienc REQUIRED IMPORTED_TARGET libbrotlienc)
+set(BROTLI_BUILD_TOOLS OFF CACHE BOOL "Build Brotli CLI" FORCE)
+add_subdirectory(../hideck-brotli hideck-brotli EXCLUDE_FROM_ALL)
+foreach(component common dec enc)
+  target_include_directories(brotli${component} PUBLIC
+    ${CMAKE_CURRENT_SOURCE_DIR}/../hideck-brotli/c/include)
+endforeach()
+add_library(PkgConfig::libbrotlicommon ALIAS brotlicommon)
+add_library(PkgConfig::libbrotlidec ALIAS brotlidec)
+add_library(PkgConfig::libbrotlienc ALIAS brotlienc)
 pkg_check_modules(liblz4 REQUIRED IMPORTED_TARGET liblz4)
 pkg_check_modules(libpcre2-8 REQUIRED IMPORTED_TARGET libpcre2-8)
@@ -104,4 +110,3 @@
-find_package(Protobuf CONFIG)
-find_package(Protobuf REQUIRED)
+find_package(Protobuf REQUIRED MODULE)
 set(THREADS_PREFER_PTHREAD_FLAG ON)
 find_package(Threads REQUIRED)
